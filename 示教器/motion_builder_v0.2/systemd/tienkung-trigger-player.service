[Unit]
Description=ROS Sample Trigger Player
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
WorkingDirectory=/home/ubuntu/tienkung_action_v0.5
ExecStart=/home/ubuntu/tienkung_action_v0.5/run_real.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target